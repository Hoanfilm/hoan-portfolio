---
// Importamos el motor de estilos de Tailwind
import '../styles/global.css';
---

<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>HOAN | Director de Fotografía</title>
    <link rel="icon" type="image/svg+xml" href="/Hoan_Logo.svg" />

    <!-- Meta Descripción optimizada para SEO -->
    <meta name="description" content="Portafolio de HOAN — Director de Fotografía en Colombia especializado en videoclips musicales y cine." />

    <!-- Open Graph (Para WhatsApp, Telegram y Redes Sociales con tu imagen destacada) -->
    <meta property="og:title" content="HOAN | Director de Fotografía" />
    <meta property="og:description" content="Portafolio de HOAN — Director de Fotografía en Colombia especializado en videoclips musicales y cine." />
    <meta property="og:image" content="https://hoanfilm.com/Image/destacada.webp" />
    <meta property="og:url" content="https://hoanfilm.com" />
    <meta property="og:type" content="website" />
</head>
<!-- Agregamos overflow-x-hidden para evitar que la página se rompa horizontalmente en móviles -->
<body class="bg-black text-[#F4F4F0] font-sans antialiased overflow-x-hidden">
    
    <!-- HEADER ESTILO HANKO (Padding ajustado para móvil) -->
    <header class="fixed top-0 w-full z-50 bg-black/80 backdrop-blur-md flex justify-between items-center p-5 md:p-8 border-b border-[#333333]">
        
        <!-- LOGO -->
        <a href="#" class="block hover:scale-95 transition-transform duration-300">
            <img src="/Hoan_Logo.svg" alt="HOAN Logo" class="w-12 h-12 md:w-16 md:h-16 object-contain" />
        </a>

        <nav class="hidden md:flex gap-8 text-sm uppercase tracking-widest font-semibold items-center">
            <a href="#" class="hover:text-[#FF0000] transition-colors duration-200">Reel</a>
            <a href="#music-videos" class="hover:text-[#FF0000] transition-colors duration-200">Music Videos</a>
            <a href="#analog" class="hover:text-[#FF0000] transition-colors duration-200">Analog</a>
            <a href="#contact" class="hover:text-[#FF0000] transition-colors duration-200">Contact</a>
        </nav>
    </header>

    <!-- MAIN (Padding ajustado para móvil) -->
    <main class="w-full max-w-7xl mx-auto px-5 md:px-8 pt-28 md:pt-32 pb-20">
        
        <!-- HERO SECTION (KASKAS) -->
        <section class="mb-24 md:mb-32">
            <!-- INDICADOR COLOMBIA -->
            <div class="flex items-center gap-3 mb-3 pl-1">
                <div class="w-2.5 h-2.5 bg-[#FF0000] rounded-full animate-pulse"></div>
                <span class="text-[10px] md:text-xs font-bold tracking-[0.3em] text-gray-400 uppercase mt-0.5">Based in Colombia</span>
            </div>

            <!-- TÍTULO ESCALABLE: text-4xl en móvil, md:text-8xl en escritorio -->
            <h1 class="text-4xl sm:text-5xl md:text-8xl font-black uppercase tracking-tighter mb-8 leading-none">
                Director of <br/> Photography
            </h1>
            
            <div class="relative w-full aspect-video bg-[#111111] border border-[#333333] flex justify-center items-center group overflow-hidden">
                <iframe class="w-full h-full object-cover" src="https://www.youtube.com/embed/65BDQ9HQpsA?controls=1&modestbranding=1" title="KASKAS - cuando quedarte atras no importa" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                
                <span class="absolute bottom-2 left-2 md:bottom-4 md:left-4 text-[10px] md:text-xs tracking-widest text-[#F4F4F0] bg-black/80 px-2 py-1 md:px-3 uppercase pointer-events-none">KASKAS - Cuando quedarte atrás no importa</span>
            </div>
        </section>

        <!-- SECCIÓN DE VIDEOCLIPS -->
        <section id="music-videos" class="mb-24 md:mb-32 pt-12">
            <div class="flex items-center gap-4 mb-8 md:mb-12">
                <div class="w-4 h-4 bg-[#FF0000]"></div>
                <h2 class="text-2xl md:text-3xl font-bold uppercase tracking-widest">Music Videos</h2>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
                
                <!-- Andy Rivera -->
                <div class="md:col-span-2 relative aspect-video bg-[#111111] border border-[#333333] group hover:border-[#FF0000] transition-colors duration-300">
                    <iframe class="w-full h-full object-cover" src="https://www.youtube.com/embed/fXagQjH9q4o?controls=1&modestbranding=1" title="Andy Rivera - Te necesito" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                    
                    <div class="absolute inset-0 flex flex-col justify-end p-4 md:p-8 bg-gradient-to-t from-black/90 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none">
                        <h3 class="text-xl md:text-2xl font-bold uppercase">Andy Rivera - Te Necesito</h3>
                        <p class="text-xs md:text-sm text-[#FF0000] tracking-widest mt-1">Dir. Fotografía: HOAN</p>
                    </div>
                </div>
                
                <!-- Niche ls -->
                <div class="relative aspect-video bg-[#111111] border border-[#333333] group hover:border-[#FF0000] transition-colors duration-300">
                    <iframe class="w-full h-full object-cover" src="https://www.youtube.com/embed/Bse2mY9B0_w?controls=1&modestbranding=1" title="Niche ls - Que pasaría" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                    
                    <div class="absolute inset-0 flex flex-col justify-end p-4 md:p-6 bg-gradient-to-t from-black/90 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none">
                        <h3 class="text-lg md:text-xl font-bold uppercase">Niche ls - Que Pasaría</h3>
                        <p class="text-[10px] md:text-xs text-[#FF0000] tracking-widest mt-1">Dir. Fotografía: HOAN</p>
                    </div>
                </div>

                <!-- Aron&Jeid -->
                <div class="relative aspect-video bg-[#111111] border border-[#333333] group hover:border-[#FF0000] transition-colors duration-300">
                    <iframe class="w-full h-full object-cover" src="https://www.youtube.com/embed/3DFUnr_N0Po?controls=1&modestbranding=1" title="Aron&Jeid - Barux" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                    
                    <div class="absolute inset-0 flex flex-col justify-end p-4 md:p-6 bg-gradient-to-t from-black/90 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none">
                        <h3 class="text-lg md:text-xl font-bold uppercase">Aron&Jeid - Barux</h3>
                        <p class="text-[10px] md:text-xs text-[#FF0000] tracking-widest mt-1">Dir. Fotografía: HOAN</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECCIÓN DE FOTOGRAFÍA ANÁLOGA -->
        <section id="analog" class="mb-24 md:mb-32 pt-12 border-t border-[#111111]">
            <div class="flex items-center gap-4 mb-8 md:mb-12 mt-8 md:mt-12">
                <div class="w-4 h-4 bg-[#FF0000]"></div>
                <h2 class="text-2xl md:text-3xl font-bold uppercase tracking-widest">Analog</h2>
            </div>
            
            <div class="columns-1 md:columns-2 gap-6 md:gap-8 space-y-6 md:space-y-8">
                <!-- Foto 1 -->
                <div class="break-inside-avoid relative group border border-[#333333] hover:border-[#FF0000] transition-colors duration-300">
                    <img src="/Image/analog-1.webp" alt="Fotografía análoga 1 HOAN" class="w-full h-auto block group-hover:grayscale transition-all duration-500" />
                </div>
                <!-- Foto 2 -->
                <div class="break-inside-avoid relative group border border-[#333333] hover:border-[#FF0000] transition-colors duration-300">
                    <img src="/Image/analog-2.webp" alt="Fotografía análoga 2 HOAN" class="w-full h-auto block group-hover:grayscale transition-all duration-500" />
                </div>
                <!-- Foto 3 -->
                <div class="break-inside-avoid relative group border border-[#333333] hover:border-[#FF0000] transition-colors duration-300">
                    <img src="/Image/analog-3.webp" alt="Fotografía análoga 3 HOAN" class="w-full h-auto block group-hover:grayscale transition-all duration-500" />
                </div>
                <!-- Foto 4 -->
                <div class="break-inside-avoid relative group border border-[#333333] hover:border-[#FF0000] transition-colors duration-300">
                    <img src="/Image/analog-4.webp" alt="Fotografía análoga 4 HOAN" class="w-full h-auto block group-hover:grayscale transition-all duration-500" />
                </div>
                <!-- Foto 5 -->
                <div class="break-inside-avoid relative group border border-[#333333] hover:border-[#FF0000] transition-colors duration-300">
                    <img src="/Image/analog-5.webp" alt="Fotografía análoga 5 HOAN" class="w-full h-auto block group-hover:grayscale transition-all duration-500" />
                </div>
                <!-- Foto 6 -->
                <div class="break-inside-avoid relative group border border-[#333333] hover:border-[#FF0000] transition-colors duration-300">
                    <img src="/Image/analog-6.webp" alt="Fotografía análoga 6 HOAN" class="w-full h-auto block group-hover:grayscale transition-all duration-500" />
                </div>
            </div>
        </section>

    </main>

    <!-- FOOTER DE CONTACTO -->
    <footer id="contact" class="w-full border-t border-[#333333] py-16 md:py-24 px-5 md:px-8 bg-[#050505]">
        <div class="w-full max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-start md:items-end gap-10 md:gap-12">
            <div>
                <!-- TÍTULO ESCALABLE FOOTER -->
                <h2 class="text-4xl sm:text-5xl md:text-8xl font-black uppercase tracking-tighter mb-4 md:mb-6 leading-none">
                    Let's <br/> <span class="text-[#FF0000]">Shoot.</span>
                </h2>
                <a href="mailto:juanmoralopez023@gmail.com" class="text-lg md:text-2xl font-bold tracking-widest text-[#F4F4F0] hover:text-[#FF0000] transition-colors duration-300 uppercase block mb-3 md:mb-4">
                    juanmoralopez023@gmail.com
                </a>
                <p class="text-[10px] md:text-xs font-bold tracking-[0.3em] text-[#555555] uppercase">Based in Colombia</p>
            </div>
            
            <div class="flex flex-col gap-3 md:gap-4 text-xs md:text-sm font-bold tracking-[0.2em] uppercase text-gray-500">
                <a href="https://www.instagram.com/hoan.raw/" target="_blank" rel="noopener noreferrer" class="hover:text-[#FF0000] transition-colors">Instagram</a>
                <a href="https://wa.me/573102271826" target="_blank" rel="noopener noreferrer" class="hover:text-[#FF0000] transition-colors">WhatsApp</a>
            </div>
        </div>
    </footer>

</body>
</html>
